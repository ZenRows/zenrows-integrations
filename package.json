{
  "name": "zenrows-integrations",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "render": "node scripts/render.mjs",
    "validate": "node scripts/validate.mjs",
    "override": "node scripts/override.mjs create",
    "override:ack": "node scripts/override.mjs ack",
    "new-host": "node scripts/new-host.mjs",
    "package": "node scripts/package.mjs",
    "mirror": "node scripts/mirror.mjs"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "yaml": "2.9.1"
  }
}
