#!/bin/sh
# Stops a commit when dist/ (or the hosts list in README.md) doesn't match a
# fresh render, or when the render's changes aren't staged. It renders nothing
# itself. Skip once with `git commit --no-verify`; CI and the pre-push hook
# still check.
. "$(dirname "$0")/check-render.sh"

# Only commits that touch what the render reads or writes.
git diff --cached --name-only | grep -qE '^(dist/|skills/|platforms/|shared/|LICENSE$|README\.md$|\.release-please-manifest\.json$)' || exit 0

if ! check_render "Checking the rendered files"; then
  echo "commit stopped: the rendered files don't match the sources." >&2
  echo "" >&2
  render_problems >&2
  echo "" >&2
  echo "dist/ is generated: don't edit it by hand. Run: npm run render" >&2
  echo "then stage the changes (git add dist README.md) and commit again." >&2
  exit 1
fi

unstaged=$(git diff --name-only -- dist README.md)
if [ -n "$unstaged" ]; then
  echo "commit stopped: rendered files changed but aren't staged:" >&2
  echo "$unstaged" | sed 's/^/  /' >&2
  echo "" >&2
  echo "Run: git add dist README.md, then commit again." >&2
  exit 1
fi
