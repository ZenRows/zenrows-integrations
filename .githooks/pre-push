#!/bin/sh
# Stops a push when dist/ or the hosts list in README.md don't match a fresh
# render. It renders nothing itself: run the command it prints, commit, push again.
# Turned on by `npm install` (the prepare script); skip once with `git push --no-verify`.
. "$(dirname "$0")/check-render.sh"

if ! check_render "Checking the rendered files before pushing"; then
  echo "push stopped: the rendered files are out of date." >&2
  echo "" >&2
  render_problems >&2
  echo "" >&2
  echo "Run: npm run render" >&2
  echo "then commit the changes and push again." >&2
  exit 1
fi
