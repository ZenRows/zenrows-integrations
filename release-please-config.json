{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-component-in-tag": true,
  "separate-pull-requests": true,
  "pull-request-title-pattern": "chore${scope}: release${component} ${version}",
  "bump-patch-for-minor-pre-major": true,
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Features"
    },
    {
      "type": "fix",
      "section": "Bug Fixes"
    },
    {
      "type": "perf",
      "section": "Performance Improvements"
    },
    {
      "type": "revert",
      "section": "Reverts"
    },
    {
      "type": "docs",
      "section": "Other",
      "hidden": true
    },
    {
      "type": "chore",
      "section": "Other",
      "hidden": true
    },
    {
      "type": "test",
      "section": "Other",
      "hidden": true
    },
    {
      "type": "ci",
      "section": "Other",
      "hidden": true
    },
    {
      "type": "refactor",
      "section": "Other",
      "hidden": true
    },
    {
      "type": "build",
      "section": "Other",
      "hidden": true
    },
    {
      "type": "style",
      "section": "Other",
      "hidden": true
    }
  ],
  "packages": {
    "dist/openclaw": {
      "component": "openclaw",
      "package-name": "openclaw",
      "extra-files": [
        {
          "type": "json",
          "path": "package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "openclaw.plugin.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": ".claude-plugin/plugin.json",
          "jsonpath": "$.version"
        }
      ]
    },
    "dist/copilot": {
      "component": "copilot",
      "package-name": "copilot",
      "extra-files": [
        {
          "type": "json",
          "path": "plugin.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "/.github/plugin/marketplace.json",
          "jsonpath": "$.metadata.version"
        },
        {
          "type": "json",
          "path": "/.github/plugin/marketplace.json",
          "jsonpath": "$.plugins[0].version"
        }
      ]
    },
    "dist/claude": {
      "component": "claude",
      "package-name": "claude",
      "extra-files": [
        {
          "type": "json",
          "path": ".claude-plugin/plugin.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "/.claude-plugin/marketplace.json",
          "jsonpath": "$.metadata.version"
        },
        {
          "type": "json",
          "path": "/.claude-plugin/marketplace.json",
          "jsonpath": "$.plugins[0].version"
        }
      ]
    },
    "dist/openai": {
      "component": "openai",
      "package-name": "openai",
      "extra-files": [
        {
          "type": "json",
          "path": "plugin.json",
          "jsonpath": "$.version"
        }
      ]
    },
    "dist/cursor": {
      "component": "cursor",
      "package-name": "cursor",
      "extra-files": [
        {
          "type": "json",
          "path": ".cursor-plugin/plugin.json",
          "jsonpath": "$.version"
        }
      ]
    },
    "dist/o11": {
      "component": "o11",
      "package-name": "o11"
    }
  }
}
